# ============================================================================
# Ce fichier est un MODÈLE destiné à l'équipe (surtout à la personne qui fait le backend).
# Le front-end en HTML/CSS/JavaScript natif NE LIT PAS de fichier .env :
# sa configuration est dans js/config.js (adresse de l'API, mode démonstration ou API).
# Ne jamais écrire ici de vrais secrets si le fichier est publié. Copier vers ".env" (ignoré par Git).
# ============================================================================

# Valeurs côté BACKEND (exemples) :
# PORT=3000
# FRONTEND_ORIGIN=http://127.0.0.1:5500    # adresse du front (Live Server) autorisée par CORS
# DATABASE_URL=...                        # à ne JAMAIS mettre dans le front-end
